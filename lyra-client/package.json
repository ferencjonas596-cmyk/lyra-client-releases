{
  "name": "lyra-client",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --configLoader native",
    "build": "tsc --noEmit && vite build --configLoader native",
    "start": "electron .",
    "package": "npm run build && electron-builder --win nsis --publish never",
    "test:desktop": "npm run build && electron . --smoke-test",
    "test": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.lyra.client",
    "productName": "Lyra Client",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "icon": "public/lyra-logo.png"
    },
    "electronDist": "node_modules/electron/dist",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Lyra-Client-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://lyraclientadatbazis.craftmc.eu/updates/"
      }
    ]
  },
  "description": "Lyra Client — Minecraft launcher shell with managed releases"
}
